<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">

    <persistence-unit name="default">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <properties>
            <!-- 1. Configuración del Driver y URL de Conexión a SQL Server -->
            <property name="javax.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver" />
            <!-- ¡IMPORTANTE! Reemplace los valores de la URL, user y password -->
            <property name="javax.persistence.jdbc.url" value="jdbc:sqlserver://localhost:1433;databaseName=BibliotecaDB;encrypt=true;trustServerCertificate=true" />
            <property name="javax.persistence.jdbc.user" value="localhost" />
            <property name="javax.persistence.jdbc.password" value="bigmaster34" />

            <!-- 2. Dialecto de Hibernate para SQL Server -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect" />

            <!-- 3. Comportamiento de la Base de Datos (Creación de Tablas ) -->
            <!-- 'update' creará/actualizará las tablas automáticamente (hbm2ddl.auto) -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- 4. Mostrar y formatear SQL (útil para depuración) -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />

            <!-- 5. Configuración de OpenXava -->
            <property name="openxava.converters.default" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
